#!/bin/sh
# launcher for the ouro CLI. resolves symlinks so /usr/local/bin/ouro -> .../current/bin/ouro works.
self="$0"
while [ -h "$self" ]; do
  dir="$(cd "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
here="$(cd "$(dirname "$self")" && pwd)"
exec node --disable-warning=ExperimentalWarning "$here/../src/cli/main.ts" "$@"
